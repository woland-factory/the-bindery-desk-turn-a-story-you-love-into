# Runtime configuration for staging/production. All optional.
# These are read at container start and written into /config.js by the
# entrypoint. Leaving one empty simply turns that integration off.

# Error tracking (GlitchTip / Sentry-compatible). Per-app DSN.
SENTRY_DSN=

# Analytics (Umami). Script endpoint and per-app website id.
UMAMI_URL=
UMAMI_WEBSITE_ID=
